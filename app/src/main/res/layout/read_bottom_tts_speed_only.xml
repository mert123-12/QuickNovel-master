<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="?attr/primaryBlackBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TTS Speed"
            android:textSize="16sp"
            android:textColor="?attr/textColor"
            android:layout_marginBottom="8dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

        <ImageView
                android:id="@+id/read_only_tts_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_baseline_volume_up_24"
                android:contentDescription="TTS" />

        <SeekBar
                android:id="@+id/read_only_tts_speed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:max="150"
                android:progress="100"
                android:thumbTint="?attr/colorOnPrimary"
                android:progressTint="?attr/colorOnPrimary"
                app:layout_constraintStart_toEndOf="@id/read_only_tts_icon"
                app:layout_constraintEnd_toStartOf="@id/read_only_tts_speed_text"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
                android:id="@+id/read_only_tts_speed_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="100%"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
